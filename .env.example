# Local development (npm run dev) — copy to .env
VITE_CONTACT_EMAIL=your.email@gmail.com
# Get your free access key at https://web3forms.com (use the same email above)
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Production build (npm run build) — copy to .env.production
# Same variable names; use your production Web3Forms key if it differs from dev.

# GitHub Pages (Settings → Secrets and variables → Actions):
# VITE_CONTACT_EMAIL, VITE_WEB3FORMS_ACCESS_KEY
